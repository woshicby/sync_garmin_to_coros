# 忽略tokens文件夹中的文件但保留文件夹本身
tokens/*
!.gitkeep

# 忽略config文件夹中的文件但保留文件夹本身
config/*
!.gitkeep

# 忽略downloads/coros/文件夹中的文件但保留文件夹本身
downloads/coros/*
!.gitkeep

# 忽略downloads/garmin/文件夹中的文件但保留文件夹本身
downloads/garmin/*
!.gitkeep

# 忽略reports文件夹中的文件但保留文件夹本身
reports/*
!.gitkeep

# Python虚拟环境
venv/
env/

# Python编译文件
__pycache__/
*.py[cod]
*$py.class

# 操作系统文件
.DS_Store
Thumbs.db

# IDE文件
.vscode/
.idea/
*.swp
*.swo

# 日志文件
*.log

# 下载文件
*.zip
*.tar.gz
*.tar.bz2

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 测试覆盖率
.coverage
coverage.xml
.pytest_cache/

# 构建输出
dist/
build/
*.egg-info/

# 临时文件
*.tmp
*.temp
.cache/